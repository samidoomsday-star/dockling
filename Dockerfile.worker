# Official Python 3.12.14 Debian 13 amd64 base, digest verified in Phase 6; no dependency/model downloads at runtime.
FROM python@sha256:44ff437bba879d4941b710a369a8f19266aea34b29002807f0c487fabc9eec9b
COPY --chmod=0644 .local-saas/build/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    https_proxy="${HTTPS_PROXY:-}" http_proxy="${HTTP_PROXY:-}" apt-get update && \
    https_proxy="${HTTPS_PROXY:-}" http_proxy="${HTTP_PROXY:-}" apt-get upgrade -y && \
    https_proxy="${HTTPS_PROXY:-}" http_proxy="${HTTP_PROXY:-}" apt-get install -y --no-install-recommends libgl1 libgomp1 libglib2.0-0t64 && rm -rf /var/lib/apt/lists/*
# No package installer, build tool or bundled bootstrap wheel in the parser runtime.
RUN python -c "import glob, shutil; [shutil.rmtree(p) for pattern in ('/usr/local/lib/python3.12/site-packages/pip*', '/usr/local/lib/python3.12/site-packages/setuptools*', '/usr/local/lib/python3.12/site-packages/wheel*', '/usr/local/lib/python3.12/ensurepip') for p in glob.glob(pattern) if __import__('os').path.isdir(p)]"
COPY --chmod=0755 src /app/src
COPY --chmod=0644 docs/PHASE0-MODEL-MANIFEST.json /app/src/stmtconv/_model-manifest.json
COPY --chmod=0755 config /app/config
COPY --chmod=0755 profiles /app/profiles
COPY --chmod=0755 templates /app/templates
WORKDIR /app
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
USER 1000:1000
CMD ["python", "-m", "stmtconv.web.worker"]
# Large verified binary layer last: avoids duplicating it on the cloud's storage driver.
COPY --chmod=0755 .local-saas/build/runtime-packages /usr/local/lib/python3.12/site-packages
