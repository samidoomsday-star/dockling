# Official Ubuntu 24.04 LTS amd64. Vendor-maintained Python 3.12; no runtime downloads.
FROM ubuntu@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b
COPY --chmod=0644 .local-saas/build/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN chmod 755 /etc/ssl /etc/ssl/certs && \
    sed -i "s|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g" /etc/apt/sources.list.d/ubuntu.sources && \
    https_proxy="${HTTPS_PROXY:-}" http_proxy="${HTTP_PROXY:-}" apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt update && \
    https_proxy="${HTTPS_PROXY:-}" http_proxy="${HTTP_PROXY:-}" apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt upgrade -y && \
    https_proxy="${HTTPS_PROXY:-}" http_proxy="${HTTP_PROXY:-}" apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt install -y --no-install-recommends python3 libgl1 libgomp1 libglib2.0-0t64 && \
    ln -s /usr/bin/python3 /usr/local/bin/python && \
    rm -rf /var/lib/apt/lists/*
# Python packaging/bootstrap tools are absent; copy the verified runtime packages.

COPY --chmod=0755 src /app/src
COPY --chmod=0644 docs/PHASE0-MODEL-MANIFEST.json /app/src/stmtconv/_model-manifest.json
COPY --chmod=0755 config /app/config
COPY --chmod=0755 profiles /app/profiles
COPY --chmod=0755 templates /app/templates
WORKDIR /app
ENV PYTHONPATH=/app/src:/usr/local/lib/python3.12/site-packages PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
USER 1000:1000
CMD ["python", "-m", "stmtconv.web.worker"]
# Large verified binary layer last: avoids duplicating it on the cloud's storage driver.
COPY --chmod=0755 .local-saas/build/runtime-packages /usr/local/lib/python3.12/site-packages
