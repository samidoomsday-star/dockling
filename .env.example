# Optional overrides. Relative paths are relative to the folder you run from.
STMTCONV_WORKSPACE=workspace
STMTCONV_LOG_LEVEL=INFO
STMTCONV_NUM_THREADS=4
STMTCONV_OFFLINE=true
DOCLING_ARTIFACTS_PATH=models
# Optional AI is not implemented until Phase 9. No key is needed now.
STMTCONV_AI_PROVIDER=
STMTCONV_AI_MODEL=
STMTCONV_AI_EFFORT=provider_default
STMTCONV_AI_API_KEY=
STMTCONV_AI_TERMS_CONFIRMED=false

