{
  "name": "dockling-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.json *.ts *.js index.html",
    "format:check": "prettier --check src tests *.json *.ts *.js index.html",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:e2e",
    "build:api": "tsc --noEmit && vite build --mode saas"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "lucide-react": "1.54.0",
    "@tanstack/react-query": "5.104.1",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-tabs": "1.1.22",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "6.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.3",
    "jsdom": "30.1.2",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3"
  }
}
