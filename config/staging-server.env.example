# TEMPLATE ONLY: copy into ignored .staging-saas/server.env; chmod 600.
# Choose the host/region/identity/storage before filling this in privately.
# No example below represents a created account or a deployed service.
STMTCONV_WEB_MODE=production
STMTCONV_WEB_BASE_URL=https://staging.example.invalid
STMTCONV_WEB_DATABASE_URL=postgresql+pg8000://dockling_app:REPLACE_PRIVATELY@database.example.invalid:5432/dockling_staging
STMTCONV_WEB_SESSION_KEY=REPLACE_WITH_GENERATED_RANDOM_SECRET
STMTCONV_WEB_OIDC_ISSUER=https://identity.example.invalid/realms/dockling
STMTCONV_WEB_OIDC_CLIENT_ID=dockling-staging-web
STMTCONV_WEB_OIDC_CLIENT_SECRET=REPLACE_WITH_GENERATED_RANDOM_SECRET
STMTCONV_WEB_ADMIN_SUBJECTS=[]
STMTCONV_WEB_S3_ENDPOINT=https://objects.example.invalid
STMTCONV_WEB_S3_ACCESS_KEY=REPLACE_PRIVATELY
STMTCONV_WEB_S3_SECRET_KEY=REPLACE_WITH_GENERATED_RANDOM_SECRET
STMTCONV_WEB_S3_BUCKET=dockling-staging-private
STMTCONV_WEB_FRONTEND_DIST=frontend/dist
STMTCONV_WEB_AI_DISPATCH_ENABLED=false
STMTCONV_WEB_COMMERCIAL_OFFERS_ENABLED=false
# Keep the independent vault key in neighboring ignored ai-key.env:
# STMTCONV_WEB_AI_ENCRYPTION_KEY=<generated 64 hex characters>
# Public CA trust is the default. For a private CA, supply an absolute PEM path:
# STMTCONV_WEB_TLS_CA_FILE=/srv/dockling/private/ca.pem
# Worker settings must use its separate least-privilege DB user and private route:
# STMTCONV_WORKER_MODE=production
# STMTCONV_WORKER_DATABASE_URL=postgresql+pg8000://dockling_worker:<secret>@<private-db>:5432/dockling_staging
# STMTCONV_WORKER_TLS_CA_FILE=/private/ca.pem
